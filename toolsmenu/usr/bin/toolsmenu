#!/bin/bash

# null next step
next(){
 x=null
}

# check path & home
if [ -z $PATH ];then
  PATH=/home/crazysx/.local/bin:/usr/local/sbin:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin
fi
if [ -z $HOME ];then
  if [[ "$(whoami)" == "root" ]];then
    echo "! you are running is root"; exit
  else
    HOME=/home/$(whoami)
  fi
fi

# check shell
if [ -d /usr/bin ];then
  os="/usr/bin"
  platform="/usr/share"
elif [ -d /data/data/com.termux/files/usr/share ];then
  os="/data/data/com.termux/files/usr/bin"
  platform="/data/data/com.termux/files/usr/share"
else
  echo "! directory share or bin not found"
  exit
fi

# check path there or not
cpath(){
  if [ -f $1 ];then
    $2
  elif [ -d $1 ];then
    $2
  else
    $3
  fi
}

# path save launcher & package
getpath(){
  if [ -f "$platform/tools-menu/pathsave" ];then
    pathsave=$(cat $platform/tools-menu/pathsave)
    if [ -z $pathsave ];then
      read -p "? create path to save : " gpath
      if [ -d "$gpath" ];then
        printf "! path found : "
        echo $gpath | tee $platform/tools-menu/pathsave
      else
        echo "! path not found"; getpath
      fi
    fi
  else
    touch $platform/tools-menu/pathsave; getpath
  fi
  if [ -z "$pathsave" ];then
    echo "manual path on /usr/share/tools-menu/pathsave for manual process"
    exit
  fi
  # check path using
  pathpkgfrom=$platform/tools-menu/package.txt
  pathpkgsave=$pathsave/package.txt
  pathlncrfrom=$HOME/.local/share/applications
  pathlncrsave=$pathsave/launcher
  cpath $pathpkgfrom "next" "touch $pathpkgfrom"
  cpath $pathpkgsave "next" "touch $pathpkgsave"
  cpath $pathlncrfrom "next" "mkdir $pathlncrfrom"
  cpath $pathlncrsave "next" "mkdir $pathlncrsave"
  # check path list categories
  pathcategory=$platform/tools-menu/list-category
  cpath $pathcategory "next" "echo \"file <[$pathcategory]> not found\"; exit"
}

# method get list launcher & package
getlist(){
  arrfrom=( "$($1 $2)" )
  arrsave=( "$($1 $3)" )
  for gfrom in ${arrfrom[@]};do
    for gsave in ${arrsave[@]};do
      if [[ "$gfrom" == "$gsave" ]];then
        getlose="$gfrom"
      fi
    done
    if [ -z "$getlose" ];then
      if [[ $4 -eq 1 ]];then
        echo $gfrom >> $3
      elif [[ $4 -eq 2 ]];then
        cp $2/$gfrom $3
      elif [[ $4 -eq 3 ]];then
        echo -e "\e[31m- $gfrom" | cut -d '.' -f 1
        echo -e "|__ $(cat $2/$gfrom | grep Exec)\n"
      elif [[ $4 -eq 4 ]];then
        echo -e "\e[31m- $gfrom"
      fi
    else
      if [[ $4 -eq  3 ]];then
        echo -e "\e[32m- $getlose" | cut -d '.' -f 1
        echo -e "|__ $(cat $2/$getlose | grep Exec)\n"
      elif [[ $4 -eq 4 ]];then
        echo -e "\e[32m- $getlose"
      fi
    fi
    unset getlose
  done
}

# method get list one while
getlistfrom(){
  arrls=( $($1 $2) )
  for gls in ${arrls[@]};do
    if [[ $4 -eq 3 ]];then
      ols=$gls
      gls=$(echo $gls | cut -d '.' -f 1)
    fi
    if [[ $3 == $gls ]];then
      gettext=$gls; getcmd=$ols
    fi
    if [ "$gettext" ];then
      if [[ $4 -eq 1 ]];then
        linecut=$(cat $2 | grep -n $gettext | cut -d ':' -f 1 | head -1 2>&1)
        sed -i "${linecut}d" $2
        echo "[ package delete ] .... [ $gettext ]"
      elif [[ $4 -eq 2 ]];then
        echo "! package found : $gettext"
      elif [[ $4 -eq 3 ]];then
        echo "! launcher found : $gettext"
        echo "|__ $(cat $2/$getcmd | grep Exec)"
      fi
    fi
    unset gettext ols
  done
}

# method create launcher
create_launcher(){
  if [ -f $HOME/.local/share/applications/$1.desktop ];then
    echo "! launcher name already using"
    exit
  fi
  cat >> $HOME/.local/share/applications/$1.desktop <<- OEM
[Desktop Entry]
Version=1.0
Type=Application
Name=$1
Comment=
Exec=/usr/share/tools-menu/exec-in-shell "$3"
Icon=$4
Categories=$2;
Terminal=true
StartupNotify=false
Path=
OEM
}

# options
if [[ $1 != "-p" ]] && [ $2 ] && [ "$3" ] && [ -z "$5" ];then
  for i in $(cat $platform/tools-menu/list-category);do
    if [[ $2 == $i ]];then
      if [ $4 ] && [ -f $4 ];then
        cp $4 $HOME/.local/share/icons/hicolor/scalable/apps
      fi
      create_launcher $1 $2 "$3" "$4"; exit
    fi
  done
  echo "usage : toolsmenu -c for check categories"
elif [[ $1 == "-c" ]] && [ -z "$2" ];then
  getpath pathcategory; cat $pathcategory
elif [[ $1 == "-l" ]];then
  if [[ "$2" == "launcher" ]] && [ -z "$3" ];then
    echo "[ LAUNCHER ] "
    getpath pathlncrfrom pathlncrsave
    getlist "ls" "$pathlncrfrom" "$pathlncrsave" 3
  elif [[ $2 == "package" ]] && [ -z "$3" ];then
    echo "[ PACKAGE ]"
    getpath pathpkgfrom pathpkgsave
    getlist "cat" "$pathpkgfrom" "$pathpkgsave" 4
  else
    echo "usage : toolsmenu -l package/launcher"
  fi
elif [[ $1 == "-d" ]] && [ $2 ] && [ -z "$3" ];then
  if [ -f $HOME/.local/share/applications/$2.desktop ];then
    rm $HOME/.local/share/applications/$2.desktop
  else
    echo "usage : toolsmenu -d [launcher_name]"
  fi
elif [[ $1 == "-m" ]] && [ -z "$3" ];then
  if [ -z "$2" ];then
    echo "usage : toolsmenu -m <[file/command_exec]>"
  elif [ -f "$2" ];then
    cmdsave=$(cat $2)
  elif [ ! -f "$2" ];then
    echo "[ file not found ] .... [ $2 ]"; exit
  else
    for r in {1..20};do
      if [ -f "$(echo $PATH | cut -d ':' -f $r)/$2" ];then
        cmdsave=$($2 --help 2>&1); break
      fi
    done
  fi
  if [ -z "$cmdsave" ];then
    echo "[ file empty ] ..... [ $2 ]"
  else
    GTK_THEME=Adwaita:dark python3 $platform/tools-menu/window-help.py "$cmdsave" "$2"
  fi
elif [[ $1 == "-k" ]] && [ -z "$2" ];then
  cd $HOME/.local/share/applications
  for laun in $(ls $HOME/.local/share/applications);do
    if [ -f $platform/applications/$laun ];then
      rm $laun
      echo "[ delete ] ..... [ $laun ]"
    fi
  done
  echo "[ delete ] ...... [ done ]"
elif [[ $1 == "-e" ]] && [ -z "$3" ];then
  if [ -z $2 ];then
    echo "usage : toolsmenu -e <[launcher]>"; exit
  fi
  for g in $(ls $HOME/.local/share/applications);do
    if [[ "$2.desktop" == $g ]];then
      nano $HOME/.local/share/applications/$g; exit
    fi
  done
  echo "! launcher <[$2]> unknown"
elif [[ $1 == "-p" ]];then
  getpath pathpkgfrom
  if [[ $2 == "-add" ]] && [ $3 ] && [ -z "$4" ];then
    echo $3 >> $pathpkgfrom
  elif [[ $2 == "-del" ]] && [ $3 ] && [ -z "$4" ];then
    getlistfrom "cat" "$pathpkgfrom" "$3" 1
  else
    echo "usage : toolsmenu -p -add/-del [package_name]"
  fi
elif [[ $1 == "-u" ]] && [ -z "$3" ];then
  if [[ $2 == "backup" ]];then
    getpath pathpkgfrom pathpkgsave pathlncrfrom pathlncrsave
    getlist "cat" "$pathpkgfrom" "$pathpkgsave" 1
    getlist "ls" "$pathlncrfrom" "$pathlncrsave" 2
  elif [[ $2 == "restore" ]];then
    getpath pathpkgfrom pathpkgsave pathlncrfrom pathlncrsave
    getlist "cat" "$pathpkgsave" "$pathpkgfrom" 1
    getlist "ls" "$pathlncrsave" "$pathlncrfrom" 2
  else
    echo "usage : toolsmenu -u backup/restore"
  fi
elif [[ $1 == "-f" ]] && [ -z "$3" ];then
  if [ -z "$2" ];then
    echo "usage : toolsmenu -f [package_name/launcher_name]"
  else
    getpath pathpkgfrom pathlncrfrom
    getlistfrom "cat" "$pathpkgfrom" "$2" 2
    getlistfrom "ls" "$pathlncrfrom" "$2" 3
  fi
else
  echo "
usage :
  toolsmenu [new_launcher] [category] [command] [nama_logo]
  toolsmenu [options] [launcher_name]

options :
-e		edit launcher
-k		clear double launcher
-m		show on window file/command help
-c		list category launcher
-l		list package/launcher
-f		find package/launcher name
-d		delete launcher
-p		-add/-del mypackage
-u		backup/restore mypackage
"
fi
